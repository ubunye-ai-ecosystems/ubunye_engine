{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ubunye-ai-ecosystems/ubunye_engine/main/docs/schemas/ubunye_hash.json",
  "description": "Ubunye's content hash of a dataset as a run read or wrote it (rows-v1).",
  "allOf": [
    {
      "$ref": "https://openlineage.io/spec/2-0-2/OpenLineage.json#/$defs/DatasetFacet"
    },
    {
      "type": "object",
      "properties": {
        "format": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "rowCount": {
          "type": [
            "integer",
            "null"
          ]
        },
        "schemaHash": {
          "type": [
            "string",
            "null"
          ]
        },
        "dataHash": {
          "type": [
            "string",
            "null"
          ]
        },
        "hashMethod": {
          "type": [
            "string",
            "null"
          ]
        },
        "hashError": {
          "type": [
            "string",
            "null"
          ]
        },
        "hashSeconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "hashBasis": {
          "description": "materialised: the hash is of the rows written; recomputed: the frame was computed again for the hash (ADR 009).",
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "materialised",
            "recomputed",
            null
          ]
        },
        "sourceVersion": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "delta",
                "files",
                "none"
              ]
            },
            "version": {
              "type": "integer",
              "description": "delta: the table version"
            },
            "timestamp": {
              "type": "string",
              "description": "delta: the version's commit time"
            },
            "timestamp_as_of": {
              "type": "string",
              "description": "delta: a read pinned by time"
            },
            "pinned": {
              "type": "boolean",
              "description": "delta: the read was pinned to this version"
            },
            "pinned_by": {
              "enum": [
                "config",
                "engine"
              ]
            },
            "latest_version": {
              "type": "integer",
              "description": "delta, at the hash: the table's latest version (information only)"
            },
            "commits_since_read": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "delta, at the hash: the operations committed since the read"
            },
            "files": {
              "type": "integer",
              "description": "files: how many files the frame reads"
            },
            "bytes": {
              "type": "integer"
            },
            "latest_modified": {
              "type": [
                "string",
                "null"
              ]
            },
            "listing_hash": {
              "type": "string",
              "description": "files: sha256 of the sorted (relative path, size, time, etag) list"
            },
            "etags": {
              "type": "boolean",
              "description": "files: every file has a content tag, so a same size and time rewrite is seen"
            },
            "missing": {
              "type": "integer"
            },
            "reason": {
              "type": "string",
              "description": "none: why there is no version"
            },
            "seconds": {
              "type": "number",
              "description": "how long taking it took"
            }
          },
          "description": "An input's source version when it was read. F-046."
        },
        "sourceVersionAtHash": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "delta",
                "files",
                "none"
              ]
            },
            "version": {
              "type": "integer",
              "description": "delta: the table version"
            },
            "timestamp": {
              "type": "string",
              "description": "delta: the version's commit time"
            },
            "timestamp_as_of": {
              "type": "string",
              "description": "delta: a read pinned by time"
            },
            "pinned": {
              "type": "boolean",
              "description": "delta: the read was pinned to this version"
            },
            "pinned_by": {
              "enum": [
                "config",
                "engine"
              ]
            },
            "latest_version": {
              "type": "integer",
              "description": "delta, at the hash: the table's latest version (information only)"
            },
            "commits_since_read": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "delta, at the hash: the operations committed since the read"
            },
            "files": {
              "type": "integer",
              "description": "files: how many files the frame reads"
            },
            "bytes": {
              "type": "integer"
            },
            "latest_modified": {
              "type": [
                "string",
                "null"
              ]
            },
            "listing_hash": {
              "type": "string",
              "description": "files: sha256 of the sorted (relative path, size, time, etag) list"
            },
            "etags": {
              "type": "boolean",
              "description": "files: every file has a content tag, so a same size and time rewrite is seen"
            },
            "missing": {
              "type": "integer"
            },
            "reason": {
              "type": "string",
              "description": "none: why there is no version"
            },
            "seconds": {
              "type": "number",
              "description": "how long taking it took"
            }
          },
          "description": "The same, taken right after the input's hash. F-046."
        },
        "sourceChanged": {
          "description": "true: the source changed between the read and the hash, so the digest is of a later state than the one read; false: it did not; null: not known. F-046.",
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    }
  ]
}
